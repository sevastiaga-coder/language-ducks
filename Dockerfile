# Рецепт сборки игры для сервера в интернете.
# Берём готовый Python, кладём рядом файлы игры и запускаем сервер —
# больше ничего не нужно, сторонних библиотек у игры нет.
FROM python:3.11-slim

WORKDIR /game
COPY . .

# Чтобы сообщения сервера сразу попадали в журнал, а не копились в памяти.
ENV PYTHONUNBUFFERED=1

CMD ["python3", "app/server.py"]
