#!/bin/bash
# Играть.command
#
# Двойной клик по этому файлу запускает игру Language Ducks.
# Ничего внутри руками менять не нужно.

# Переходим в папку app рядом с этим файлом — так игра работает,
# даже если всю папку с проектом перенести в другое место на диске.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/app" || {
    echo "Не нашёл папку игры рядом с этим файлом."
    read -p "Нажми Enter, чтобы закрыть это окно... " _
    exit 1
}

PORT=8000

clear
echo ""
echo "============================================="
echo "              LANGUAGE DUCKS"
echo "============================================="
echo ""

# Если порт занят прошлым запуском игры (забыли закрыть старое
# окно) — закрываем прошлый сервер и запускаемся заново, чтобы не
# падать с непонятной ошибкой.
OLD_PID=$(lsof -ti tcp:$PORT)
if [ -n "$OLD_PID" ]; then
    echo "  Игра уже была открыта в другом окне."
    echo "  Закрываю прошлый запуск и начинаю заново..."
    echo ""
    kill $OLD_PID 2>/dev/null
    sleep 1
fi

OLD_PID=$(lsof -ti tcp:$PORT)
if [ -n "$OLD_PID" ]; then
    echo "  Не получилось освободить место для игры —"
    echo "  похоже, этот адрес занят какой-то другой программой."
    echo "  Попробуй закрыть все старые окна с игрой и запустить снова."
    echo ""
    read -p "  Нажми Enter, чтобы закрыть это окно... " _
    exit 1
fi

# Открываем экран для ноутбука в браузере, когда сервер поднимется
( sleep 1 && open "http://localhost:$PORT/screen.html" ) &

python3 server.py
